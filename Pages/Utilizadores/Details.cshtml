@page
@model Biblioteca.Pages_Utilizadores.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Utilizador</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Utilizador.Nome)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Utilizador.Nome)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Utilizador.Tel)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Utilizador.Tel)
        </dd>
    </dl>

    <h4 class="mt-4">Livros levantados</h4>

    @if (Model.Utilizador.Livros.Any())
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Título</th>
                    <th>Autor</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var livro in Model.Utilizador.Livros)
            {
                <tr>
                    <td><a asp-page="/Livros/Details" asp-route-id="@livro.LivroID">@livro.Titulo</a></td>
                    <td>@livro.Autor</td>
                </tr>
            }
            </tbody>
        </table>
    }
    else
    {
        <p class="text-muted">Este utilizador não levantou nenhum livro.</p>
    }
</div>

<div>
    <a asp-page="./Edit" asp-route-id="@Model.Utilizador.UserID">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
