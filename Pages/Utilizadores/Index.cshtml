@page
@model Biblioteca.Pages_Utilizadores.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@if (User.Identity?.IsAuthenticated == true)
{
    <p><a asp-page="Create">Create New</a></p>
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Utilizador[0].Nome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Utilizador[0].Tel)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Utilizador) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Tel)
            </td>
            <td>
                <a asp-page="./Details" asp-route-id="@item.UserID">Details</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <span>|</span>
                    <a asp-page="./Edit" asp-route-id="@item.UserID">Edit</a> 
                    <span>|</span>
                    <a asp-page="./Delete" asp-route-id="@item.UserID">Delete</a>     
                }
            </td>
        </tr>
}
    </tbody>
</table>
